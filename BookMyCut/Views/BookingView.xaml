<Window x:Class="BookMyCut.Views.BookingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        AllowsTransparency="True" 
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Title="Réservation">

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
        <Border Background="#CC000000" 
                CornerRadius="20" 
                Padding="40" 
                Margin="20" 
                MinWidth="450"
                MaxWidth="600">
            <StackPanel>
                <TextBlock Text="{Binding TitreFenetre}" 
                           FontSize="26" 
                           FontWeight="Bold" 
                           Foreground="#E0B03D" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,35"/>

                <TextBlock Text="Choisir un Service" Foreground="White" FontSize="14" Margin="0,10,0,8"/>
                <ComboBox ItemsSource="{Binding Services}" 
                          SelectedItem="{Binding ServiceSelectionne}" 
                          DisplayMemberPath="Nom" 
                          Padding="12"
                          FontSize="14"/>

                <TextBlock Text="Choisir un Coiffeur" Foreground="White" FontSize="14" Margin="0,20,0,8"/>
                <ComboBox ItemsSource="{Binding Coiffeurs}" 
                          SelectedItem="{Binding CoiffeurSelectionne}" 
                          DisplayMemberPath="NomComplet" 
                          Padding="12"
                          FontSize="14"/>

                <TextBlock Text="Choisir une Date" Foreground="White" FontSize="14" Margin="0,20,0,8"/>
                <DatePicker SelectedDate="{Binding DateSelectionnee}" 
                            Padding="10"
                            FontSize="14"
                            HorizontalAlignment="Stretch"/>

                <TextBlock Text="Choisir une Heure" Foreground="White" FontSize="14" Margin="0,20,0,8"/>
                <ComboBox ItemsSource="{Binding HeuresDisponibles}"
                          SelectedItem="{Binding HeureSelectionnee}"
                          Padding="12"
                          FontSize="14"/>

                <Button Content="{Binding TexteBouton}" 
                        Command="{Binding ConfirmerRendezVousCommand}"
                        Margin="0,35,0,0" 
                        Height="55"
                        Background="#E86C1A" 
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="ANNULER" 
                        Click="Annuler_Click"
                        Margin="0,10,0,0" 
                        Background="Transparent" 
                        Foreground="#88FFFFFF" 
                        BorderThickness="0"
                        Cursor="Hand"/>

                <TextBlock Text="* Votre réservation sera confirmée instantanément" 
                           Foreground="#88FFFFFF" 
                           FontSize="11" 
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,0" 
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>