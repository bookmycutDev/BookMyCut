<UserControl x:Class="BookMyCut.Views.ModifierProfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             Background="Transparent">

    <Grid Margin="40">
        <Border Background="#33000000"
                CornerRadius="20"
                Padding="30"
                MaxWidth="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Modifier mon profil"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#E0B03D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Border x:Name="MessageBoxInline"
                        Background="#00000000"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,20"
                        Visibility="Collapsed">
                    <TextBlock x:Name="txtMessageInline"
                               Text=""
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>

                <TextBlock Text="Nom complet"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="txtNomComplet"
                         Height="35"
                         Padding="8"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Email"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail"
                         Height="35"
                         Padding="8"
                         Margin="0,0,0,15"
                         IsReadOnly="True"
                         Background="#444444"
                         Foreground="#DDDDDD"
                         BorderBrush="#666666"
                         Cursor="Arrow"
                         Opacity="0.85"/>

                <TextBlock Text="Nouveau mot de passe"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtMotDePasse"
                             Height="35"
                             Padding="8"
                             Margin="0,0,0,15"/>

                <TextBlock Text="Confirmer le mot de passe"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtConfirmerMotDePasse"
                             Height="35"
                             Padding="8"
                             Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Enregistrer"
                            Width="150"
                            Height="42"
                            Margin="0,0,10,0"
                            Background="#E86C1A"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnEnregistrerClick"/>

                    <Button Content="Retour à l'accueil"
                            Width="150"
                            Height="42"
                            Background="#444444"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnRetourClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>