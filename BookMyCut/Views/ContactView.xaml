<Window x:Class="BookMyCut.Views.ContactView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contact" Height="350" Width="450">

	<Grid Background="White">
		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

			<TextBlock Text="Contact"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="10"/>

			<TextBlock Text="Adresse :" FontWeight="Bold" Margin="10,10,10,0"/>
			<TextBlock Text="123 Rue du Style, Montréal" Margin="10"/>

			<TextBlock Text="Téléphone :" FontWeight="Bold" Margin="10,10,10,0"/>
			<TextBlock Text="(514) 555-1234" Margin="10"/>

			<TextBlock Text="Heures :" FontWeight="Bold" Margin="10,10,10,0"/>
			<TextBlock Text="Lun - Sam : 9h00 à 18h00" Margin="10"/>

			<Button Content="Fermer"
                    Width="100"
                    Margin="10"
                    HorizontalAlignment="Center"
                    Click="BtnFermerClick"/>

		</StackPanel>
	</Grid>
</Window>