<Window x:Class="BookMyCut.Views.ConnexionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BookMyCut.ViewModels"
        Title="BookMyCut - Connexion" Height="350" Width="400" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:ConnexionViewModel />
    </Window.DataContext>

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CONNEXION" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <TextBlock Text="Email" Margin="0,10,0,5"/>
            <TextBox Text="2288532@cegepmv.ca" Padding="8"/>

            <TextBlock Text="Mot de passe" Margin="0,15,0,5"/>
            <PasswordBox x:Name="TxtPassword" Padding="8" PasswordChanged="PasswordBox_PasswordChanged" Password="12334"/>

            <Button Content="SE CONNECTER" 
                    Command="{Binding SeConnecterCommand}" 
                    Margin="0,30,0,0" Padding="12" 
                    Background="#3498DB" Foreground="White" FontWeight="Bold" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>