<Window x:Class="BookMyCut.Views.ConnexionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BookMyCut.ViewModels"
        Title="BookMyCut - Connexion" 
        Width="400" 
        SizeToContent="Height" 
        MinWidth="350"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F7">

    <Grid Margin="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="CONNEXION" 
                           FontSize="26" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30" 
                           Foreground="#2C3E50"/>

                <TextBlock Text="Email" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#555" 
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="12"
                         FontSize="14"/>

                <TextBlock Text="Mot de passe" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#555" 
                           Margin="0,15,0,8"/>
                <PasswordBox x:Name="TxtPassword" 
                             Padding="12" 
                             FontSize="14"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <Button Content="SE CONNECTER" 
                        Command="{Binding SeConnecterCommand}" 
                        Margin="0,35,0,0" 
                        Padding="15" 
                        Background="#3498DB" 
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Pas de compte ? Créer un compte" 
                        Command="{Binding AllerAInscriptionCommand}"
                        Background="Transparent" 
                        BorderBrush="Transparent" 
                        Foreground="#2980B9" 
                        Cursor="Hand"
                        FontSize="13"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>