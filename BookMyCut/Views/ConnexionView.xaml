<Window x:Class="BookMyCut.Views.ConnexionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Connexion utilisateur"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Border Width="430"
                Padding="40"
                Background="White"
                CornerRadius="8"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Se connecter"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="Black"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,30">
                    <TextBlock Text="Nouveau sur ce site ? "
                               FontSize="18"
                               VerticalAlignment="Center"/>

                    <Button Content="S'inscrire"
                            Click="Inscription_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="Blue"
                            Cursor="Hand"
                            Padding="0"
                            FontSize="18"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="E-mail *"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="txtEmail"
                         Height="45"
                         FontSize="18"
                         Padding="10"
                         Margin="0,0,0,15"
                         BorderBrush="Black"
                         BorderThickness="1.5"/>

                <TextBlock Text="Mot de passe *"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="txtPassword"
                             Height="45"
                             FontSize="18"
                             Padding="10"
                             Margin="0,0,0,15"
                             BorderBrush="Black"
                             BorderThickness="1.5"/>

                <TextBlock Margin="0,0,0,25">
                    <Hyperlink Click="MotDePasseOublie_Click">
                        <Run Text="Mot de passe oublié ?"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock x:Name="txtMessage"
                           Foreground="Red"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"/>

                <Button x:Name="btnConnexion"
                        Content="Se connecter"
                        Height="52"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Background="Black"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnConnexion_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>