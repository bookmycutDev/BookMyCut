<Window x:Class="BookMyCut.Views.AdminRolesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BookMyCut.ViewModels"
        xmlns:models="clr-namespace:BookMyCut.Data.Models;assembly=BookMyCut.dataa"
        Title="Gestion des Rôles - Admin" 
        Height="550" Width="800" 
        MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Administration des Utilisateurs" 
                       FontSize="22" FontWeight="Bold" Foreground="#2C3E50"
                       VerticalAlignment="Center"/>

            <Button Content="DÉCONNEXION" 
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Command="{Binding DeconnexionCommand}"
                    Padding="15,8" 
                    Background="#FF6B6B" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    BorderThickness="0" 
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Utilisateurs}" 
                      SelectedItem="{Binding UtilisateurSelectionne}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="35"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Nom Complet" Binding="{Binding NomComplet}" Width="2*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                    <DataGridTextColumn Header="Rôle Actuel" Binding="{Binding Role}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,20,0,0" Padding="15" Background="#E9ECEF" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Changer le rôle en :" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>

                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Coiffeur" 
                                Command="{Binding ModifierRoleCommand}" 
                                CommandParameter="{x:Static models:RoleUtilisateur.Coiffeur}" 
                                Width="100" Height="35" Margin="0,5,10,5" 
                                Background="#F39C12" Foreground="White" BorderThickness="0"/>

                        <Button Content="Admin" 
                                Command="{Binding ModifierRoleCommand}" 
                                CommandParameter="{x:Static models:RoleUtilisateur.Admin}" 
                                Width="100" Height="35" Margin="0,5,10,5" 
                                Background="#E74C3C" Foreground="White" BorderThickness="0"/>

                        <Button Content="Client" 
                                Command="{Binding ModifierRoleCommand}" 
                                CommandParameter="{x:Static models:RoleUtilisateur.Client}" 
                                Width="100" Height="35" Margin="0,5,10,5" 
                                Background="#3498DB" Foreground="White" BorderThickness="0"/>
                    </WrapPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="Gérer les Services" 
                        Command="{Binding OuvrirGestionServicesCommand}" 
                        Padding="20,0" Height="40"
                        Background="#20B2AA" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>