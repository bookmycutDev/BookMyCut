<Window x:Class="BookMyCut.Views.InscriptionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BookMyCut.ViewModels"
        Title="BookMyCut - Inscription" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:InscriptionViewModel />
    </Window.DataContext>

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="CRÉER UN COMPTE" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="#2C3E50"/>

            <TextBlock Text="Prénom" Margin="0,10,0,5"/>
            <TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"/>

            <TextBlock Text="Nom" Margin="0,10,0,5"/>
            <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"/>

            <TextBlock Text="Email" Margin="0,10,0,5"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"/>

            <TextBlock Text="Mot de passe" Margin="0,10,0,5"/>
            <PasswordBox x:Name="TxtPassword" Padding="8"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <TextBlock Text="Confirmer le mot de passe" Margin="0,10,0,5"/>
            <PasswordBox x:Name="TxtConfirmPassword" Padding="8"
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

            <Button Content="CRÉER MON COMPTE"
                    Command="{Binding CreerCompteCommand}"
                    Margin="0,25,0,0" Padding="12"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>

        </StackPanel>
    </Grid>
</Window>