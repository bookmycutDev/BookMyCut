<UserControl x:Class="BookMyCut.Views.HistoriqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Border Background="#4D000000" CornerRadius="20" Padding="25">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Historique de mes rendez-vous"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#E0B03D"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Rendez-vous à venir"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,15"/>

                    <ItemsControl ItemsSource="{Binding RendezVousFuturs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22FFFFFF"
                                        Margin="0,0,0,12"
                                        Padding="15"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Service.Nom}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>

                                        <TextBlock Text="{Binding DateHeure, StringFormat='{}{0:dd MMMM yyyy à HH:mm}'}"
                                                   Foreground="#E0B03D"
                                                   Margin="0,4"/>

                                        <TextBlock Text="{Binding Coiffeur.NomComplet, StringFormat='Avec {0}'}"
                                                   Foreground="#CCCCCC"/>

                                        <TextBlock Text="{Binding Statut, StringFormat='Statut : {0}'}"
                                                   Foreground="#AAAAAA"
                                                   FontStyle="Italic"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Rendez-vous passés"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,25,0,15"/>

                    <ItemsControl ItemsSource="{Binding RendezVousPasses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16000000"
                                        Margin="0,0,0,12"
                                        Padding="15"
                                        CornerRadius="10"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Service.Nom}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>

                                        <TextBlock Text="{Binding DateHeure, StringFormat='{}{0:dd MMMM yyyy à HH:mm}'}"
                                                   Foreground="#E0B03D"
                                                   Margin="0,4"/>

                                        <TextBlock Text="{Binding Coiffeur.NomComplet, StringFormat='Avec {0}'}"
                                                   Foreground="#CCCCCC"/>

                                        <TextBlock Text="{Binding Statut, StringFormat='Statut : {0}'}"
                                                   Foreground="#AAAAAA"
                                                   FontStyle="Italic"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Aucun rendez-vous dans votre historique."
                               Foreground="#88FFFFFF"
                               FontStyle="Italic"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>