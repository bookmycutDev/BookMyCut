<UserControl x:Class="BookMyCut.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
            <TextBlock Text="{Binding NomClient, StringFormat='Ravi de vous revoir, {0} !'}" 
                       FontSize="28" Foreground="#E0B03D" Margin="0,0,0,10"/>

            <TextBlock Text="Prêt pour votre&#10;nouveau look ?" 
                       FontSize="44" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

            <Button x:Name="BtnPrendreRDV"
                Content="PRENDRE RENDEZ-VOUS" 
                Click="BtnPrendreRDV_Click"
                Width="220" Height="50" HorizontalAlignment="Left"
                Background="#E86C1A" Foreground="White" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <Border Grid.Column="1" Background="#33000000" CornerRadius="15" Padding="20">
            <StackPanel>
                <TextBlock Text="Mes Prochains Rendez-vous" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                <ItemsControl ItemsSource="{Binding MesRendezVous}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#44FFFFFF" Margin="0,0,0,10" Padding="15" CornerRadius="8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Service.Nom}" FontWeight="Bold" Foreground="White" FontSize="16"/>
                                        <TextBlock Text="{Binding DateHeure, StringFormat='{}{0:dd MMMM yyyy à HH:mm}'}" Foreground="#E0B03D" Margin="0,2"/>
                                        <TextBlock Text="{Binding Coiffeur.NomComplet, StringFormat='Avec {0}'}" Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="LightGreen" FontSize="24"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Vous n'avez aucun rendez-vous pour le moment." 
                           Foreground="#88FFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,30,0,0" 
                           FontStyle="Italic"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="{Binding HasNoAppointments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>