<UserControl x:Class="BookMyCut.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel Margin="0,0,30,0" MaxWidth="500">
                <TextBlock Text="{Binding NomClient, StringFormat='Ravi de vous revoir, {0} !'}" 
                           FontSize="28" Foreground="#E0B03D" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="Prêt pour votre&#10;nouveau look ?" 
                           FontSize="48" FontWeight="Bold" Foreground="White" Margin="0,0,0,25" LineHeight="55"/>

                <Button x:Name="BtnPrendreRDV"
                        Content="PRENDRE RENDEZ-VOUS" 
                        Command="{Binding OuvrirBookingCommand}"
                        Width="240" Height="55" HorizontalAlignment="Left"
                        Background="#E86C1A" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Viewbox>

        <Border Grid.Column="1" Background="#4D000000" CornerRadius="20" Padding="20" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mes Prochains Rendez-vous" 
                           FontSize="22" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding MesRendezVous}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22FFFFFF" Margin="0,0,0,12" Padding="15" CornerRadius="10" BorderBrush="#11FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Service.Nom}" FontWeight="Bold" Foreground="White" FontSize="16"/>
                                                <TextBlock Text="{Binding DateHeure, StringFormat='{}{0:dd MMMM yyyy à HH:mm}'}" Foreground="#E0B03D" Margin="0,4"/>
                                                <TextBlock Text="{Binding Coiffeur.NomComplet, StringFormat='Avec {0}'}" Foreground="#AAAAAA" FontSize="12" FontStyle="Italic"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                              <TextBlock Text="✓"
                                                Foreground="#4CAF50"
                                                FontSize="26"
                                                Opacity="0.8"
                                                Margin="0,0,10,0"/>

                                              <Button Content="X"
                                                Width="30"
                                                Height="30"
                                                Background="#AA0000"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SupprimerRendezVousCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                                
                                            </StackPanel>


                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Vous n'avez aucun rendez-vous prévu. C'est le moment de changer de tête !" 
                                   Foreground="#66FFFFFF" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,40,0,0" 
                                   FontStyle="Italic"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="{Binding HasNoAppointments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>