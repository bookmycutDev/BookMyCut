<Window x:Class="BookMyCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookMyCut" Height="720" Width="1200"
        MinHeight="600" MinWidth="900" 
        WindowStartupLocation="CenterScreen" Background="Black">

    <Window.Resources>
        <!-- Style pour les boutons de navigation -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Arrière-plan avec image -->
        <Grid.Background>
            <ImageBrush ImageSource="imgs/BookMyCutBG.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Filtre sombre pour la lisibilité -->
        <Rectangle Fill="#B3000000"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="85"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Contenu -->
                <RowDefinition Height="60"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- BARRE DE NAVIGATION (HEADER) -->
            <Border Grid.Row="0" Background="#40000000" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                <Grid Margin="30,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✂" FontSize="28" Foreground="#E0B03D" Margin="0,0,12,0"/>
                        <TextBlock Text="Book" FontSize="30" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="MyCut" FontSize="30" FontWeight="Bold" Foreground="#E86C1A"/>
                    </StackPanel>

                    <!-- Menu et Utilisateur -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Liaison avec MessageBienvenue du MainViewModel -->
                        <TextBlock Text="{Binding MessageBienvenue}" 
                                   Foreground="White" 
                                   FontSize="14" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,20,0" 
                                   FontStyle="Italic"
                                   Opacity="0.7"/>

                        <!-- Navigation vers l'Accueil -->
                        <Button Content="Accueil" 
                                Style="{StaticResource NavButtonStyle}" 
                                Command="{Binding AfficherAccueilCommand}"/>

                        <!-- Navigation vers les Services -->
                        <Button Content="Services" 
                                Style="{StaticResource NavButtonStyle}" 
                                Command="{Binding AfficherServicesCommand}"/>

                        <!-- Déconnexion (Gérée par le Code-Behind car elle ferme la Window) -->
                        <Button Content="Déconnexion" 
                                Style="{StaticResource NavButtonStyle}" 
                                Foreground="#FF6B6B" 
                                FontWeight="SemiBold"
                                Margin="15,0,0,0" 
                                Click="BtnDeconnexion_Click"/>
                        <Button Content="Historique"
                                Style="{StaticResource NavButtonStyle}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="15,0,0,0"
                                Command="{Binding AfficherHistoriqueCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENU DYNAMIQUE -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Liaison avec CurrentContent du MainViewModel -->
                    <ContentControl Content="{Binding CurrentContent}" Margin="20"/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="#40000000">
                <TextBlock Text="© 2026 BookMyCut — Votre style, notre passion" 
                           Foreground="#88FFFFFF" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>