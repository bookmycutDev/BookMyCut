<Window x:Class="BookMyCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BookMyCut" Height="720" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="Black">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="imgs/BookMyCutBG.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Rectangle Fill="#99000000"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="85"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#25000000">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✂" FontSize="26" Foreground="#E0B03D" Margin="0,0,10,0"/>
                        <TextBlock Text="Book" FontSize="30" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="MyCut" FontSize="30" FontWeight="Bold" Foreground="#E86C1A"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock x:Name="txtUser" 
               Text="Bonjour, d d !" 
               Foreground="White" 
               FontSize="15" 
               VerticalAlignment="Center" 
               Margin="0,0,25,0" 
               FontStyle="Italic"
               Opacity="0.8"/>

                        <Button Content="Accueil" 
            Style="{StaticResource NavButtonStyle}" 
            Margin="5,0" 
            Click="BtnAccueil_Click"/>

                        <Button Content="Services" 
            Style="{StaticResource NavButtonStyle}" 
            Margin="5,0" 
            Click="BtnServices_Click"/>

                        <Button Content="Déconnexion" 
            Style="{StaticResource NavButtonStyle}" 
            Foreground="#FF6B6B" 
            FontWeight="Bold"
            Margin="20,0,0,0" 
            Click="BtnDeconnexion_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="40,20"/>

            <Border Grid.Row="2" Background="#25000000">
                <TextBlock Text="© 2026 BookMyCut - Votre style, notre passion" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>