<Window x:Class="BookMyCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookMyCut" Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="Black">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="imgs/BookMyCutBG.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#B3000000"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="85"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#40000000" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                <Grid Margin="30,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo MASTER conservé -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✂" FontSize="28" Foreground="#E0B03D" Margin="0,0,12,0"/>
                        <TextBlock Text="Book" FontSize="30" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="MyCut" FontSize="30" FontWeight="Bold" Foreground="#E86C1A"/>
                    </StackPanel>

                    <!-- Menu Jonathan2.0 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtUser"
                                   Text="Bonjour !"
                                   Foreground="White"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"
                                   FontStyle="Italic"
                                   Opacity="0.8"/>

                        <Button Content="Accueil"
                                Style="{StaticResource NavButtonStyle}"
                                Click="BtnAccueil_Click"/>

                        <Button Content="Modifier profil"
                                Style="{StaticResource NavButtonStyle}"
                                Click="BtnModifierProfil_Click"/>

                        <Button Content="Nos coiffeurs"
                                Style="{StaticResource NavButtonStyle}"
                                Click="BtnNosCoiffeurs_Click"/>

                        <Button Content="Services"
                                Style="{StaticResource NavButtonStyle}"
                                Click="BtnServices_Click"/>

                        <Button Content="Historique"
                                Style="{StaticResource NavButtonStyle}"
                                Click="BtnHistorique_Click"/>

                        <Button Content="Déconnexion"
                                Style="{StaticResource NavButtonStyle}"
                                Foreground="#FF6B6B"
                                FontWeight="SemiBold"
                                Margin="15,0,0,0"
                                Click="BtnDeconnexion_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="MainContent" Margin="20"/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="#40000000">
                <TextBlock Text="© 2026 BookMyCut — Votre style, notre passion"
                           Foreground="#88FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>
