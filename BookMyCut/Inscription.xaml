<Window x:Class="BookMyCut.Inscription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookMyCut"
        mc:Ignorable="d"
        Title="Inscription" Height="350" Width="350">

    <Grid>
        
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
            <TextBlock Text="Créer un compte" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="10"/>

            <TextBlock Text="Prénom"/>
            <TextBox x:Name="txtPrenom" Margin="2"/>
            
            <TextBlock Text="Nom"/>
            <TextBox x:Name="txtNom" Margin="2"/>

            <TextBlock Text="Email"/>
            <TextBox x:Name="txtEmail" Margin="2"/>

            <TextBlock Text="Mot de passe"/>
            <PasswordBox x:Name="txtMdp" Margin="2"/>

            <TextBlock Text="Confirmer le mot de passe"/>
            <PasswordBox x:Name="txtValidMdp" Margin="2"/>

            <Button Content="Créer" Margin="10" Click="BtnCreerClick" Background="#4CAF50"/>
            <Button Content="Fermer" Margin="10" Click="BtnFermerClick" Background="#E0E0E0"/>
        </StackPanel>
    </Grid>
</Window>
